func runSweeper(ctx context.Context, dir string) {
	tick := time.NewTicker(time.Hour)
	defer tick.Stop()
	for {
		select {
		case <-ctx.Done():
			return
		case now := <-tick.C:
			n, err := sweepSessions(ctx, dir, now.Add(-sessionMaxAge))
			fmt.Fprintf(os.Stderr, "sweep: removed %d abandoned sessions (err: %v)\n", n, err)
		}
	}
}